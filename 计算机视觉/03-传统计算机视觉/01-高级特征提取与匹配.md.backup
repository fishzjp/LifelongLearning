## 几何验证

### 6.1 RANSAC算法

```python
print("\n=== RANSAC几何验证 ===")

def compute_homography(kp1, kp2):
    """计算单应性矩阵"""
    # 源点和目标点
    src = np.array([[kp[0], kp[1]] for kp in kp1])
    dst = np.array([[kp[0], kp[1]] for kp in kp2])

    # 构建A矩阵
    A = []
    for i in range(len(src)):
        x, y = src[i]
        u, v = dst[i]
        A.append([x, y, 1, 0, 0, 0, -u*x, -u*y, -u])
        A.append([0, 0, 0, x, y, 1, -v*x, -v*y, -v])

    A = np.array(A)

    # SVD求解
    U, S, Vt = np.linalg.svd(A)
    H = Vt[-1].reshape(3, 3)

    # 归一化
    H = H / H[2, 2]

    return H

def ransac_homography(matches, threshold=5.0, max_iters=1000):
    """RANSAC计算单应性矩阵"""
    if len(matches) < 4:
        return None, []

    best_H = None
    best_inliers = []
    best_num_inliers = 0

    for iter in range(max_iters):
        # 随机选择4个匹配
        sample = np.random.choice(len(matches), 4, replace=False)

        # 提取对应点
        src_kps = [matches[i]['kp1'] for i in sample]
        dst_kps = [matches[i]['kp2'] for i in sample]

        # 计算单应性矩阵
        try:
            H = compute_homography(src_kps, dst_kps)
        except:
            continue

        # 计算内点
        inliers = []
        for match in matches:
            kp1 = match['kp1']
            kp2 = match['kp2']

            # 变换点
            src_pt = np.array([kp1[0], kp1[1], 1])
            dst_pt = H @ src_pt
            dst_pt = dst_pt / dst_pt[2]

            # 计算误差
            error = np.sqrt((dst_pt[0] - kp2[0])**2 + (dst_pt[1] - kp2[1])**2)

            if error < threshold:
                inliers.append(match)

        # 更新最佳模型
        if len(inliers) > best_num_inliers:
            best_num_inliers = len(inliers)
            best_inliers = inliers
            best_H = H

    # 使用所有内点重新计算H
    if len(best_inliers) >= 4:
        src_kps = [m['kp1'] for m in best_inliers]
        dst_kps = [m['kp2'] for m in best_inliers]
        best_H = compute_homography(src_kps, dst_kps)

    return best_H, best_inliers

# 应用RANSAC
if len(matches) >= 4:
    H, inliers = ransac_homography(matches, threshold=5.0)

    print(f"原始匹配: {len(matches)}")
    print(f"内点数量: {len(inliers)}")
    print(f"内点比例: {len(inliers)/len(matches)*100:.1f}%")

    if H is not None:
        print("\n单应性矩阵:")
        print(H)

    # 可视化RANSAC结果
    fig, axes = plt.subplots(1, 2, figsize=(12, 5))

    # 原始匹配
    combined = np.hstack([img1, img2])
    axes[0].imshow(combined, cmap='gray', vmin=0, vmax=255)
    offset_x = img1.shape[1]
    for match in matches:
        kp1 = match['kp1']
        kp2 = match['kp2']
        axes[0].plot([kp1[0], kp2[0] + offset_x], [kp1[1], kp2[1]],
                    'r-', linewidth=0.5, alpha=0.3)
    axes[0].set_title(f'原始匹配 ({len(matches)})')
    axes[0].axis('off')

    # RANSAC后匹配
    axes[1].imshow(combined, cmap='gray', vmin=0, vmax=255)
    for match in inliers:
        kp1 = match['kp1']
        kp2 = match['kp2']
        axes[1].plot([kp1[0], kp2[0] + offset_x], [kp1[1], kp2[1]],
                    'g-', linewidth=1, alpha=0.6)
    axes[1].set_title(f'RANSAC内点 ({len(inliers)})')
    axes[1].axis('off')

    plt.tight_layout()
    plt.show()
else:
    print("匹配点不足，无法进行RANSAC")

print("\nRANSAC流程：")
print("1. 随机采样4个点")
print("2. 计算模型（单应性）")
print("3. 评估所有点")
print("4. 记录内点")
print("5. 重复直到满意")
print("6. 用内点重新计算")
```

