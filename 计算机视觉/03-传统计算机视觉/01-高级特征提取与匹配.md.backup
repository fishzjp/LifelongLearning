## ORB算法

### 4.1 ORB原理与实现

```python
print("\n=== ORB算法 ===")

class ORBDetector:
    """ORB特征检测器（简化版）"""

    def __init__(self, n_features=500, scale_factor=1.2):
        self.n_features = n_features
        self.scale_factor = scale_factor

    def fast_detector(self, img, threshold=20):
        """FAST角点检测"""
        h, w = img.shape
        corners = []

        # 16个圆周点偏移
        offsets = [
            (0, 3), (1, 3), (2, 2), (3, 1),
            (3, 0), (3, -1), (2, -2), (1, -3),
            (0, -3), (-1, -3), (-2, -2), (-3, -1),
            (-3, 0), (-3, 1), (-2, 2), (-1, 3)
        ]

        for i in range(3, h-3):
            for j in range(3, w-3):
                center = img[i, j]

                # 检查连续12个点
                bright_count = 0
                dark_count = 0

                for dx, dy in offsets:
                    neighbor = img[i+dy, j+dx]
                    if neighbor > center + threshold:
                        bright_count += 1
                    elif neighbor < center - threshold:
                        dark_count += 1

                if bright_count >= 12 or dark_count >= 12:
                    corners.append((j, i))

        return corners

    def harris_response(self, img, corners):
        """Harris响应值排序"""
        responses = []

        for x, y in corners:
            # 计算局部Harris响应
            if x < 2 or y < 2 or x >= img.shape[1]-2 or y >= img.shape[0]-2:
                continue

            # 计算梯度
            Ix = img[y, x+1] - img[y, x-1]
            Iy = img[y+1, x] - img[y-1, x]

            # 结构张量
            Ixx = Ix * Ix
            Iyy = Iy * Iy
            Ixy = Ix * Iy

            # Harris响应
            R = Ixx * Iyy - 0.04 * (Ixx + Iyy) ** 2
            responses.append((x, y, R))

        # 按响应值排序
        responses = sorted(responses, key=lambda x: x[2], reverse=True)
        return responses[:self.n_features]

    def brief_descriptor(self, img, keypoints):
        """BRIEF描述子"""
        descriptors = []

        # 预定义的256对点对
        np.random.seed(42)
        pairs = np.random.randint(-4, 5, size=(256, 4))

        for x, y, _ in keypoints:
            desc = []
            for p in pairs:
                dx1, dy1, dx2, dy2 = p

                x1, y1 = x + dx1, y + dy1
                x2, y2 = x + dx2, y + dy2

                # 边界检查
                if 0 <= x1 < img.shape[1] and 0 <= y1 < img.shape[0] and \
                   0 <= x2 < img.shape[1] and 0 <= y2 < img.shape[0]:
                    desc.append(1 if img[y1, x1] < img[y2, x2] else 0)
                else:
                    desc.append(0)

            descriptors.append(np.array(desc))

        return np.array(descriptors)

    def detect(self, img):
        """ORB检测流程"""
        # 1. FAST角点检测
        corners = self.fast_detector(img)

        # 2. Harris响应排序
        keypoints = self.harris_response(img, corners)

        # 3. 计算BRIEF描述子
        descriptors = self.brief_descriptor(img, keypoints)

        return keypoints, descriptors

# 测试ORB
orb = ORBDetector(n_features=200)
orb_kps, orb_desc = orb.detect(test_img)

print(f"ORB检测到 {len(orb_kps)} 个关键点")
print(f"描述子形状: {orb_desc.shape}")

# 可视化
plt.figure(figsize=(6, 6))
plt.imshow(test_img, cmap='gray', vmin=0, vmax=255)
for x, y, r in orb_kps:
    plt.plot(x, y, 'go', markersize=4, alpha=0.7)
plt.title(f'ORB: {len(orb_kps)}个点')
plt.axis('off')
plt.show()

print("\nORB特点：")
print("✓ FAST角点 + Harris响应")
print("✓ BRIEF描述子（二进制）")
print("✓ 旋转不变性（rBRIEF）")
print("✓ 尺度不变性（金字塔）")
print("✓ 极快，适合实时应用")
```

