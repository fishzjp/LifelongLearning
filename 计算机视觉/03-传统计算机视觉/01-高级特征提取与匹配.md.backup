## 特征匹配技术

### 5.1 最近邻匹配

```python
print("\n=== 特征匹配 ===")

def create_match_test_images():
    """创建匹配测试图像"""
    # 图像1
    img1 = np.ones((100, 100), dtype=np.uint8) * 200
    img1[20:40, 20:40] = 50
    img1[60:80, 60:80] = 100
    img1 = add_gaussian_noise(img1, 5)

    # 图像2（平移+轻微变换）
    img2 = np.ones((100, 100), dtype=np.uint8) * 200
    img2[25:45, 30:50] = 50
    img2[65:85, 70:90] = 100
    img2 = add_gaussian_noise(img2, 5)

    return img1, img2

img1, img2 = create_match_test_images()

# 提取特征
orb = ORBDetector(n_features=50)
kps1, desc1 = orb.detect(img1)
kps2, desc2 = orb.detect(img2)

print(f"图像1特征: {len(kps1)}")
print(f"图像2特征: {len(kps2)}")

# 最近邻匹配
def match_features(desc1, desc2, kps1, kps2, ratio_threshold=0.75):
    """特征匹配（最近邻 + 比率测试）"""
    matches = []

    for i, d1 in enumerate(desc1):
        # 计算与所有描述子的距离
        distances = []
        for j, d2 in enumerate(desc2):
            # 汉明距离（二进制描述子）
            dist = np.sum(d1 != d2)
            distances.append((j, dist))

        # 排序
        distances.sort(key=lambda x: x[1])

        # 最近邻和次近邻
        best_idx, best_dist = distances[0]
        second_idx, second_dist = distances[1] if len(distances) > 1 else (0, 1)

        # 比率测试
        if best_dist < ratio_threshold * second_dist:
            matches.append({
                'query_idx': i,
                'train_idx': best_idx,
                'distance': best_dist,
                'kp1': kps1[i],
                'kp2': kps2[best_idx]
            })

    return matches

matches = match_features(desc1, desc2, kps1, kps2, ratio_threshold=0.75)

print(f"匹配数: {len(matches)}")

# 可视化匹配
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

axes[0].imshow(img1, cmap='gray', vmin=0, vmax=255)
for kp in kps1:
    axes[0].plot(kp[0], kp[1], 'ro', markersize=3)
axes[0].set_title(f'图像1 ({len(kps1)}个特征)')
axes[0].axis('off')

axes[1].imshow(img2, cmap='gray', vmin=0, vmax=255)
for kp in kps2:
    axes[1].plot(kp[0], kp[1], 'bo', markersize=3)
axes[1].set_title(f'图像2 ({len(kps2)}个特征)')
axes[1].axis('off')

plt.tight_layout()
plt.show()

# 显示匹配连线
fig, ax = plt.subplots(figsize=(8, 8))
combined = np.hstack([img1, img2])
ax.imshow(combined, cmap='gray', vmin=0, vmax=255)

offset_x = img1.shape[1]
for match in matches[:10]:  # 显示前10个
    kp1 = match['kp1']
    kp2 = match['kp2']
    ax.plot([kp1[0], kp2[0] + offset_x], [kp1[1], kp2[1]],
            'g-', linewidth=1, alpha=0.6)
    ax.plot(kp1[0], kp1[1], 'ro', markersize=4)
    ax.plot(kp2[0] + offset_x, kp2[1], 'bo', markersize=4)

ax.set_title(f'特征匹配 (显示前10个)')
ax.axis('off')
plt.show()

print("\n匹配策略：")
print("1. 最近邻：距离最小")
print("2. 比率测试：best/second < threshold")
print("3. 阈值过滤：距离 < max_dist")
print("4. RANSAC：几何验证")
```

### 5.2 匹配质量评估

```python
print("\n匹配质量评估")

def evaluate_matches(matches):
    """评估匹配质量"""
    if len(matches) == 0:
        return None

    # 距离统计
    distances = [m['distance'] for m in matches]

    # 平均距离
    mean_dist = np.mean(distances)
    std_dist = np.std(distances)

    # 距离分布
    plt.figure(figsize=(12, 4))

    plt.subplot(1, 3, 1)
    plt.hist(distances, bins=20, alpha=0.7, color='green')
    plt.axvline(mean_dist, color='red', linestyle='--', label=f'均值={mean_dist:.2f}')
    plt.title('匹配距离分布')
    plt.xlabel('汉明距离')
    plt.ylabel('频数')
    plt.legend()
    plt.grid(True, alpha=0.3)

    # 匹配点位置
    plt.subplot(1, 3, 2)
    x_coords = [m['kp1'][0] for m in matches]
    y_coords = [m['kp1'][1] for m in matches]
    plt.scatter(x_coords, y_coords, c=distances, cmap='Reds', alpha=0.7)
    plt.colorbar(label='距离')
    plt.title('匹配点分布')
    plt.xlabel('x')
    plt.ylabel('y')
    plt.grid(True, alpha=0.3)

    # 距离 vs 位置
    plt.subplot(1, 3, 3)
    plt.scatter(range(len(distances)), distances, alpha=0.7)
    plt.axhline(mean_dist + 2*std_dist, color='red', linestyle='--', label='2σ')
    plt.title('距离序列')
    plt.xlabel('匹配索引')
    plt.ylabel('距离')
    plt.legend()
    plt.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.show()

    return {
        'num_matches': len(matches),
        'mean_distance': mean_dist,
        'std_distance': std_dist,
        'quality': '好' if mean_dist < 50 else '一般' if mean_dist < 100 else '差'
    }

quality = evaluate_matches(matches)
if quality:
    print(f"匹配数量: {quality['num_matches']}")
    print(f"平均距离: {quality['mean_distance']:.2f}")
    print(f"距离标准差: {quality['std_distance']:.2f}")
    print(f"匹配质量: {quality['quality']}")
```

