## SIFT算法详解

### 2.1 SIFT原理与实现

```python
print("\n=== SIFT算法详解 ===")

class SIFTDetector:
    """SIFT特征检测器（简化版）"""

    def __init__(self, n_octaves=4, n_intervals=5, sigma=1.6):
        self.n_octaves = n_octaves
        self.n_intervals = n_intervals
        self.sigma = sigma
        self.k = 2 ** (1/3)

    def build_gaussian_pyramid(self, img):
        """构建高斯金字塔"""
        pyramid = []
        base = gaussian_filter(img.astype(np.float32), sigma=self.sigma)

        for octave in range(self.n_octaves):
            octave_images = []
            for interval in range(self.n_intervals):
                sigma = self.sigma * (self.k ** interval)
                octave_images.append(gaussian_filter(base, sigma=sigma))
            pyramid.append(octave_images)
            # 下采样
            base = base[::2, ::2]

        return pyramid

    def build_dog_pyramid(self, gaussian_pyramid):
        """构建高斯差分金字塔（DoG）"""
        dog_pyramid = []
        for octave in gaussian_pyramid:
            dog_octave = []
            for i in range(len(octave)-1):
                dog = octave[i+1] - octave[i]
                dog_octave.append(dog)
            dog_pyramid.append(dog_octave)
        return dog_pyramid

    def find_extrema(self, dog_pyramid, threshold=0.03):
        """寻找极值点"""
        keypoints = []

        for octave_idx, octave in enumerate(dog_pyramid):
            for i in range(1, len(octave)-1):
                current = octave[i]
                prev = octave[i-1]
                next_img = octave[i+1]

                h, w = current.shape
                for y in range(1, h-1):
                    for x in range(1, w-1):
                        # 3x3x3邻域比较
                        region = current[y-1:y+2, x-1:x+2]
                        max_val = np.max(region)
                        min_val = np.min(region)

                        current_val = current[y, x]

                        # 检查是否为极值
                        if (current_val >= max_val or current_val <= min_val) and \
                           abs(current_val) > threshold:

                            # 简化：直接记录位置和尺度
                            scale = self.sigma * (self.k ** i)
                            keypoints.append({
                                'x': x * (2 ** octave_idx),
                                'y': y * (2 ** octave_idx),
                                'scale': scale,
                                'octave': octave_idx,
                                'response': abs(current_val)
                            })

        return keypoints

    def detect(self, img):
        """完整SIFT检测流程"""
        # 1. 构建高斯金字塔
        gaussian = self.build_gaussian_pyramid(img)

        # 2. 构建DoG金字塔
        dog = self.build_dog_pyramid(gaussian)

        # 3. 寻找极值点
        keypoints = self.find_extrema(dog)

        # 4. 简化：非极大值抑制
        keypoints = self.non_max_suppression(keypoints)

        return keypoints

    def non_max_suppression(self, keypoints, distance=5):
        """非极大值抑制"""
        if len(keypoints) == 0:
            return []

        # 按响应值排序
        keypoints = sorted(keypoints, key=lambda k: k['response'], reverse=True)

        selected = []
        for kp in keypoints:
            too_close = False
            for skp in selected:
                dist = np.sqrt((kp['x'] - skp['x'])**2 + (kp['y'] - skp['y'])**2)
                if dist < distance:
                    too_close = True
                    break

            if not too_close:
                selected.append(kp)

        return selected

# 测试SIFT
sift = SIFTDetector(n_octaves=3, n_intervals=3)
keypoints = sift.detect(test_img)

print(f"SIFT检测到 {len(keypoints)} 个关键点")

# 可视化
plt.figure(figsize=(6, 6))
plt.imshow(test_img, cmap='gray', vmin=0, vmax=255)
for kp in keypoints[:20]:  # 显示前20个
    plt.plot(kp['x'], kp['y'], 'o',
             markersize=kp['scale']*2,
             markerfacecolor='none',
             markeredgecolor='red',
             markeredgewidth=1)
    plt.plot(kp['x'], kp['y'], 'r.', markersize=2)

plt.title(f'SIFT关键点 (显示前20个)')
plt.axis('off')
plt.show()

print("\nSIFT算法步骤：")
print("1. 尺度空间构建 → 高斯金字塔")
print("2. DoG计算 → 检测极值点")
print("3. 关键点精确定位")
print("4. 方向分配 → 旋转不变")
print("5. 描述子生成 → 128维向量")
```

### 2.2 SIFT描述子生成

```python
print("\nSIFT描述子生成")

def compute_sift_descriptor(img, kp, patch_size=16):
    """计算SIFT描述子（简化版）"""
    x, y, scale = int(kp['x']), int(kp['y']), kp['scale']

    # 提取邻域
    half = patch_size // 2
    y1, y2 = max(0, y-half), min(img.shape[0], y+half)
    x1, x2 = max(0, x-half), min(img.shape[1], x+half)

    patch = img[y1:y2, x1:x2]

    if patch.size == 0:
        return None

    # 调整到固定大小
    patch = cv2.resize(patch, (patch_size, patch_size))

    # 计算梯度
    gy, gx = np.gradient(patch.astype(np.float32))
    magnitude = np.sqrt(gx**2 + gy**2)
    direction = np.arctan2(gy, gx)

    # 分为4x4网格，每个网格8个方向直方图
    descriptor = []
    grid_size = patch_size // 4

    for i in range(4):
        for j in range(4):
            # 提取网格
            mag_block = magnitude[i*grid_size:(i+1)*grid_size,
                                 j*grid_size:(j+1)*grid_size]
            dir_block = direction[i*grid_size:(i+1)*grid_size,
                                 j*grid_size:(j+1)*grid_size]

            # 8方向直方图
            hist = np.zeros(8)
            for angle in range(8):
                angle_start = angle * np.pi / 4
                angle_end = (angle + 1) * np.pi / 4

                mask = (dir_block >= angle_start) & (dir_block < angle_end)
                hist[angle] = np.sum(mag_block[mask])

            descriptor.extend(hist)

    descriptor = np.array(descriptor)

    # 归一化
    norm = np.linalg.norm(descriptor)
    if norm > 0:
        descriptor = descriptor / norm

    # 截断（限制最大值）
    descriptor = np.clip(descriptor, 0, 0.2)

    # 再次归一化
    norm = np.linalg.norm(descriptor)
    if norm > 0:
        descriptor = descriptor / norm

    return descriptor

# 计算描述子
if len(keypoints) > 0:
    descriptors = []
    valid_kps = []

    for kp in keypoints:
        desc = compute_sift_descriptor(test_img, kp)
        if desc is not None:
            descriptors.append(desc)
            valid_kps.append(kp)

    descriptors = np.array(descriptors)

    print(f"计算了 {len(descriptors)} 个128维描述子")
    print(f"描述子形状: {descriptors.shape}")

    # 显示描述子
    plt.figure(figsize=(10, 4))
    plt.subplot(1, 2, 1)
    plt.imshow(test_img, cmap='gray', vmin=0, vmax=255)
    for kp in valid_kps[:10]:
        plt.plot(kp['x'], kp['y'], 'ro', markersize=5)
    plt.title('关键点')
    plt.axis('off')

    plt.subplot(1, 2, 2)
    plt.imshow(descriptors[:10].T, cmap='hot', aspect='auto')
    plt.title('前10个描述子')
    plt.xlabel('关键点索引')
    plt.ylabel('描述子维度')

    plt.tight_layout()
    plt.show()
```

