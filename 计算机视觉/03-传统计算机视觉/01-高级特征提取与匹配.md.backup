## SURF算法

### 3.1 SURF原理

```python
print("\n=== SURF算法 ===")

class SURFDetector:
    """SURF特征检测器（简化版）"""

    def __init__(self, hessian_threshold=100):
        self.threshold = hessian_threshold

    def integral_image(self, img):
        """积分图"""
        return np.cumsum(np.cumsum(img, axis=0), axis=1)

    def hessian_response(self, img, size):
        """Hessian矩阵响应（简化）"""
        # 使用近似Hessian滤波器
        # Dxx = [-1, -2, -1; 0, 0, 0; 1, 2, 1]
        # Dyy = [-1, 0, 1; -2, 0, 2; -1, 0, 1]
        # Dxy = [-1, 0, 1; 0, 0, 0; -1, 0, 1]

        kernel_xx = np.array([[-1, -2, -1], [0, 0, 0], [1, 2, 1]])
        kernel_yy = np.array([[-1, 0, 1], [-2, 0, 2], [-1, 0, 1]])
        kernel_xy = np.array([[-1, 0, 1], [0, 0, 0], [-1, 0, 1]])

        Lxx = convolve(img.astype(np.float32), kernel_xx)
        Lyy = convolve(img.astype(np.float32), kernel_yy)
        Lxy = convolve(img.astype(np.float32), kernel_xy)

        # Hessian响应
        det = Lxx * Lyy - 0.81 * Lxy * Lxy
        return det

    def detect(self, img):
        """SURF检测"""
        # 构建尺度空间（使用盒式滤波器近似）
        responses = []

        for scale in [5, 9, 15, 25]:  # 不同尺度
            # 高斯模糊
            smoothed = gaussian_filter(img.astype(np.float32), sigma=scale/6)

            # 计算Hessian响应
            response = self.hessian_response(smoothed, scale)
            responses.append(response)

        # 寻找极值点
        keypoints = []
        for scale_idx, response in enumerate(responses):
            scale = [5, 9, 15, 25][scale_idx]

            h, w = response.shape
            for y in range(3, h-3):
                for x in range(3, w-3):
                    # 3x3邻域比较
                    region = response[y-1:y+2, x-1:x+2]
                    max_val = np.max(region)

                    if response[y, x] >= max_val and response[y, x] > self.threshold:
                        keypoints.append({
                            'x': x,
                            'y': y,
                            'scale': scale,
                            'response': response[y, x]
                        })

        # 非极大值抑制
        keypoints = sorted(keypoints, key=lambda k: k['response'], reverse=True)
        selected = []
        for kp in keypoints:
            too_close = False
            for skp in selected:
                dist = np.sqrt((kp['x'] - skp['x'])**2 + (kp['y'] - skp['y'])**2)
                if dist < 5:
                    too_close = True
                    break
            if not too_close:
                selected.append(kp)

        return selected

# 测试SURF
surf = SURFDetector(hessian_threshold=50)
surf_kps = surf.detect(test_img)

print(f"SURF检测到 {len(surf_kps)} 个关键点")

# 可视化对比
fig, axes = plt.subplots(1, 2, figsize=(10, 5))

axes[0].imshow(test_img, cmap='gray', vmin=0, vmax=255)
for kp in keypoints[:15]:
    axes[0].plot(kp['x'], kp['y'], 'ro', markersize=5, alpha=0.7)
axes[0].set_title(f'SIFT: {len(keypoints)}个点')
axes[0].axis('off')

axes[1].imshow(test_img, cmap='gray', vmin=0, vmax=255)
for kp in surf_kps[:15]:
    axes[1].plot(kp['x'], kp['y'], 'bo', markersize=5, alpha=0.7)
axes[1].set_title(f'SURF: {len(surf_kps)}个点')
axes[1].axis('off')

plt.tight_layout()
plt.show()

print("\nSURF特点：")
print("✓ 使用积分图加速")
print("✓ 盒式滤波器近似")
print("✓ 比SIFT快3-10倍")
print("✓ 鲁棒性略低于SIFT")
```

