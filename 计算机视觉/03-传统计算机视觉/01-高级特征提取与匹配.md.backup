## 实践练习

### 练习1：完整特征匹配流程

```python
"""
练习1：完整特征匹配流程

目标：实现完整的特征检测-匹配-验证流程

任务：
1. 创建两幅图像（有重叠区域）
2. 使用不同特征检测器
3. 进行特征匹配
4. RANSAC验证
5. 评估性能
"""

def practice1_complete_matching():
    print("="*60)
    print("练习1：完整特征匹配流程")
    print("="*60)

    # 创建测试图像
    img_a = np.ones((120, 120), dtype=np.uint8) * 200
    img_b = np.ones((120, 120), dtype=np.uint8) * 200

    # 添加特征
    features = [(30, 30), (80, 30), (30, 80), (80, 80)]
    for x, y in features:
        img_a[y-5:y+5, x-5:x+5] = 50
        img_b[y-3:y+7, x+3:x+13] = 50  # 平移

    # 添加噪声
    img_a = add_gaussian_noise(img_a, 5)
    img_b = add_gaussian_noise(img_b, 5)

    # 检测器对比
    detectors = {
        'ORB': ORBDetector(n_features=100),
        'FAST': None,  # 简化
    }

    results = {}

    for name, detector in detectors.items():
        if name == 'ORB':
            kps1, desc1 = detector.detect(img_a)
            kps2, desc2 = detector.detect(img_b)

            # 匹配
            matches = match_features(desc1, desc2, kps1, kps2)

            # RANSAC
            H, inliers = ransac_homography(matches, threshold=5.0)

            results[name] = {
                'kps1': len(kps1),
                'kps2': len(kps2),
                'matches': len(matches),
                'inliers': len(inliers) if inliers else 0
            }

    # 显示结果
    print("\n检测器性能对比：")
    for name, result in results.items():
        print(f"{name}:")
        print(f"  特征点: {result['kps1']} / {result['kps2']}")
        print(f"  匹配数: {result['matches']}")
        print(f"  内点数: {result['inliers']}")

    # 可视化
    fig, axes = plt.subplots(1, 2, figsize=(12, 5))

    axes[0].imshow(img_a, cmap='gray', vmin=0, vmax=255)
    axes[0].set_title('图像A')
    axes[0].axis('off')

    axes[1].imshow(img_b, cmap='gray', vmin=0, vmax=255)
    axes[1].set_title('图像B')
    axes[1].axis('off')

    plt.tight_layout()
    plt.show()

practice1_complete_matching()
```

### 练习2：特征检测器对比

```python
"""
练习2：特征检测器对比

目标：对比不同检测器在不同条件下的表现

任务：
1. 创建多尺度、多旋转的测试图像
2. 测试SIFT、SURF、ORB
3. 评估检测数量、稳定性
4. 分析优缺点
"""

def practice2_detector_comparison():
    print("="*60)
    print("练习2：特征检测器对比")
    print("="*60)

    # 创建复杂测试图像
    img = np.ones((150, 150), dtype=np.uint8) * 200

    # 多尺度特征
    img[20:30, 20:30] = 50      # 小
    img[60:90, 60:90] = 50      # 中
    img[110:140, 20:30] = 50    # 小

    # 添加纹理
    for i in range(0, 150, 10):
        img[i:i+2, :] = 150

    # 添加噪声
    img = add_gaussian_noise(img, 8)

    # 测试不同尺度
    scales = [1.0, 1.5, 2.0]
    results = {}

    for scale in scales:
        scaled = cv2.resize(img, None, fx=scale, fy=scale)

        # SIFT（简化）
        sift = SIFTDetector(n_octaves=2, n_intervals=2)
        kps_sift = sift.detect(scaled)

        # SURF
        surf = SURFDetector(hessian_threshold=50)
        kps_surf = surf.detect(scaled)

        # ORB
        orb = ORBDetector(n_features=100)
        kps_orb, _ = orb.detect(scaled)

        results[scale] = {
            'SIFT': len(kps_sift),
            'SURF': len(kps_surf),
            'ORB': len(kps_orb)
        }

    # 显示结果
    print("\n不同尺度下的检测数量：")
    print("尺度\tSIFT\tSURF\tORB")
    for scale, res in results.items():
        print(f"{scale:.1f}x\t{res['SIFT']}\t{res['SURF']}\t{res['ORB']}")

    # 可视化
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))

    for idx, scale in enumerate(scales):
        scaled = cv2.resize(img, None, fx=scale, fy=scale)
        axes[idx].imshow(scaled, cmap='gray', vmin=0, vmax=255)
        axes[idx].set_title(f'尺度 {scale:.1f}x')
        axes[idx].axis('off')

    plt.tight_layout()
    plt.show()

    print("\n分析：")
    print("SIFT：最稳定，但最慢")
    print("SURF：平衡性能和稳定性")
    print("ORB：最快，适合实时")

practice2_detector_comparison()
```

### 练习3：RANSAC参数调优

```python
"""
练习3：RANSAC参数调优

目标：理解RANSAC参数对结果的影响

任务：
1. 创建带噪声的匹配
2. 测试不同阈值
3. 测试不同迭代次数
4. 分析内点比例变化
"""

def practice3_ransac_tuning():
    print("="*60)
    print("练习3：RANSAC参数调优")
    print("="*60)

    # 创建带噪声的匹配
    np.random.seed(42)

    # 真实匹配（内点）
    true_matches = []
    for i in range(20):
        x = np.random.randint(10, 90)
        y = np.random.randint(10, 90)
        true_matches.append({
            'kp1': (x, y),
            'kp2': (x+5, y+3),
            'distance': np.random.randint(0, 20)
        })

    # 外点
    outliers = []
    for i in range(10):
        outliers.append({
            'kp1': (np.random.randint(10, 90), np.random.randint(10, 90)),
            'kp2': (np.random.randint(10, 90), np.random.randint(10, 90)),
            'distance': np.random.randint(50, 100)
        })

    matches = true_matches + outliers
    np.random.shuffle(matches)

    print(f"总匹配数: {len(matches)}")
    print(f"真实内点: {len(true_matches)}")

    # 测试不同参数
    thresholds = [3.0, 5.0, 10.0]
    iterations = [100, 500, 1000]

    results = []

    for threshold in thresholds:
        for max_iter in iterations:
            H, inliers = ransac_homography(matches, threshold=threshold, max_iters=max_iter)

            if H is not None:
                # 计算准确率
                correct = 0
                for match in inliers:
                    if match in true_matches:
                        correct += 1

                accuracy = correct / len(true_matches) if len(true_matches) > 0 else 0

                results.append({
                    'threshold': threshold,
                    'iterations': max_iter,
                    'inliers': len(inliers),
                    'accuracy': accuracy
                })

    # 显示结果
    print("\nRANSAC参数测试：")
    print("阈值\t迭代\t内点\t准确率")
    for r in results:
        print(f"{r['threshold']:.1f}\t{r['iterations']}\t{r['inliers']}\t{r['accuracy']:.2f}")

    # 可视化
    fig, axes = plt.subplots(1, 2, figsize=(12, 5))

    thresholds_plot = [r['threshold'] for r in results]
    inliers_plot = [r['inliers'] for r in results]
    accuracy_plot = [r['accuracy'] for r in results]

    axes[0].scatter(thresholds_plot, inliers_plot, c='blue', s=50)
    axes[0].set_xlabel('阈值')
    axes[0].set_ylabel('内点数')
    axes[0].set_title('阈值 vs 内点数')
    axes[0].grid(True, alpha=0.3)

    axes[1].scatter(thresholds_plot, accuracy_plot, c='red', s=50)
    axes[1].set_xlabel('阈值')
    axes[1].set_ylabel('准确率')
    axes[1].set_title('阈值 vs 准确率')
    axes[1].grid(True, alpha=0.3)

    plt.tight_layout()
    plt.show()

    print("\n参数选择建议：")
    print("阈值：3-5像素（根据图像分辨率）")
    print("迭代：500-1000（平衡精度和速度）")
    print("内点比例 > 50% 通常可靠")

practice3_ransac_tuning()
```

